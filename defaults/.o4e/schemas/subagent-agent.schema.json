{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "opencode-for-everything subagent",
  "type": "object",
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "name": { "$ref": "./agent-common.schema.json#/$defs/agentName" },
    "plan": { "$ref": "./agent-common.schema.json#/$defs/planProfile" },
    "model": { "$ref": "./agent-common.schema.json#/$defs/nullableModelRef" },
    "fallbackModels": { "type": "array", "items": { "$ref": "./agent-common.schema.json#/$defs/modelRef" }, "uniqueItems": true },
    "description": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" },
    "backgroundTasks": { "$ref": "./agent-common.schema.json#/$defs/backgroundTasksConfig" },
    "nativeSystem": { "$ref": "./agent-common.schema.json#/$defs/nativeSystem" },
    "base": { "type": "string" },
    "systemPrompt": { "$ref": "./agent-common.schema.json#/$defs/promptName" },
    "injects": { "type": "array", "items": { "$ref": "./agent-common.schema.json#/$defs/promptName" }, "uniqueItems": true },
    "messagePrompt": { "$ref": "./agent-common.schema.json#/$defs/promptName" },
    "promptDir": { "type": "string", "minLength": 1 },
    "instructionFiles": { "$ref": "./agent-common.schema.json#/$defs/instructionFiles" },
    "loadSkills": { "$ref": "./agent-common.schema.json#/$defs/loadableSkillNameList" },
    "loadTools": { "$ref": "./agent-common.schema.json#/$defs/nullableToolNameList" },
    "loadMcp": { "$ref": "./agent-common.schema.json#/$defs/mcpToolAccess" },
    "blockSkills": { "$ref": "./agent-common.schema.json#/$defs/blockNameList" },
    "blockTools": { "$ref": "./agent-common.schema.json#/$defs/toolNameList" },
    "blockMcp": { "$ref": "./agent-common.schema.json#/$defs/blockNameList" },
    "blockAgents": { "$ref": "./agent-common.schema.json#/$defs/blockNameList" },
    "blockWorkflows": { "$ref": "./agent-common.schema.json#/$defs/blockNameList" }

    ,"permission": { "$ref": "./agent-common.schema.json#/$defs/permissionConfig" }
    ,"loadAgents": { "$ref": "./agent-common.schema.json#/$defs/loadableAgentNameList" }
    ,"loadWorkflows": { "$ref": "./agent-common.schema.json#/$defs/loadableWorkflowNameList" }
    ,"capabilities": { "$ref": "./agent-common.schema.json#/$defs/capabilityList" }
  },
  "required": ["name"],
  "additionalProperties": false,
  "allOf": [
    { "not": { "required": ["base", "systemPrompt"] } },
    { "not": { "required": ["nativeSystem", "base"] } },
    { "not": { "required": ["nativeSystem", "systemPrompt"] } },
    { "not": { "required": ["nativeSystem", "injects"] } }
  ]
}
