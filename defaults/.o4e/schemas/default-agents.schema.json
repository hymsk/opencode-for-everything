{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "opencode-for-everything default agent catalog",
  "type": "object",
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "./agent-common.schema.json#/$defs/agentName" },
          "type": { "enum": ["primary", "subagent", "all"] },
          "displayName": { "$ref": "#/$defs/localizedText" },
          "roleName": { "$ref": "#/$defs/localizedText" },
          "description": { "$ref": "#/$defs/localizedText" },
          "defaultEnabled": { "type": "boolean" }
        },
        "required": ["id", "type", "displayName", "roleName", "description", "defaultEnabled"],
        "additionalProperties": false
      }
    }
  },
  "required": ["agents"],
  "additionalProperties": false,
  "$defs": {
    "localizedText": {
      "type": "object",
      "properties": {
        "zh": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" },
        "en": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" }
      },
      "required": ["zh", "en"],
      "additionalProperties": false
    }
  }
}
