      // [o4e:catalogDisplayName] 安装器显示名称，必须同时提供 zh 和 en。
      "displayName": { "zh": "Architect", "en": "Architect" },
      // [o4e:catalogRoleName] 安装器显示的简短职责，必须同时提供 zh 和 en。
      "roleName": { "zh": "系统设计 / 模块关系", "en": "System design / Module relations" },
      // [o4e:catalogDescription] 运行时 selector description，必须同时提供 zh 和 en，且不能在默认具体 JSONC 中重复声明。
      "description": { "zh": "负责系统设计、模块关系、边界和演进方案", "en": "Designs systems, module relationships, boundaries, and evolution paths" },
      "defaultEnabled": true
    },
    {
      "id": "reviewer",
      "type": "subagent",
      "displayName": { "zh": "Reviewer", "en": "Reviewer" },
      "roleName": { "zh": "独立代码 / 架构审查", "en": "Independent code / Architecture review" },
      "description": { "zh": "独立审查代码与架构变更，识别实质风险和测试缺口", "en": "Independently reviews code and architecture changes for material risks and testing gaps" },
      "defaultEnabled": true
    },
    {
