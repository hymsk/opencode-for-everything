{
  // [o4e:catalogSchema] 默认 agent 目录的 Schema；此文件保存 all/primary/subagent 元数据，不定义 system 内部阶段。
  "$schema": "../schemas/default-agents.schema.json",
  // [o4e:catalogAgents] 安装器按数组顺序展示这些默认 agent；新增或删除默认角色时同步维护其具体 JSONC。
  "agents": [
    {
      // [o4e:catalogId] 稳定默认 agent ID；必须与对应目录中的文件名和 name 一致。
      "id": "orchestrator",
      // [o4e:catalogType] 决定具体 JSONC 所在的 all、primary 或 subagent 目录；源文件不声明 mode。
      "type": "all",
      // [o4e:catalogDisplayName] 安装器显示名称，必须同时提供 zh 和 en。
      "displayName": { "zh": "Orchestrator", "en": "Orchestrator" },
      // [o4e:catalogRoleName] 安装器显示的简短职责，必须同时提供 zh 和 en。
      "roleName": { "zh": "总工程师 / 调度", "en": "Chief engineer / Orchestrator" },
      // [o4e:catalogDescription] 运行时 selector description，必须同时提供 zh 和 en，且不能在默认具体 JSONC 中重复声明。
      "description": { "zh": "总工程师与任务调度，负责拆解目标、选择角色和收敛交付", "en": "Chief engineer for task decomposition, routing, and delivery convergence" },
      "defaultEnabled": true
    },
    {
      // [o4e:catalogId] 稳定默认 agent ID；必须与对应目录中的文件名和 name 一致。
      "id": "architect",
