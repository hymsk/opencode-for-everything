{
  // [o4e:schema] 供编辑器校验和补全；移动文件时保持相对路径正确。
  "$schema": "../../schemas/all-agent.schema.json",
  // [o4e:name] 稳定 ID；必须与文件名及默认目录中的条目一致。
  "name": "orchestrator",
  // null 继承全局 defaultModel；[] 关闭本 Agent 的 fallback。
  "model": null,
  "fallbackModels": [],
  // [o4e:defaultMetadata] 默认 agent 的 description 只能在 agents/default.jsonc 中修改。
  // [o4e:nativeNone] all Agent 不允许声明 nativeMode；原生模式只能由 primary 接管。
  // [o4e:planChild] 保留可写 orchestrator，并额外生成只读 orchestrator (plan)；对象内可覆盖权限、工具、MCP、Agent、Workflow 和 reminder。
  "plan": { "mode": "child" },
  // [o4e:promptCore] 完整 system prompt 的 Markdown 路径；如改用 base 或 nativeSystem，必须删除本项并遵守三者互斥关系。
  "systemPrompt": "all/orchestrator/system",
  // [o4e:injects] 按顺序追加到 systemPrompt 后的 prompt 片段；[] 明确不追加。
  "injects": ["shared/task-authority"],
  // [o4e:messagePrompt] 当前未配置 messagePrompt。该字段没有 null/false 形式；仅在需要追加消息提示词时填写 Markdown 路径。
  // [o4e:promptDir] 当前安装目标的 prompt 目录；修改时需同时迁移本文件引用的 Markdown。
  "promptDir": "prompts/cn",
  // [o4e:instructionFiles] 完整规则文件覆盖；某个范围使用 [] 表示不读取该范围的规则文件。
  "instructionFiles": {
    "global": ["<default>"],
    "project": ["<default>"]
  },
  // [o4e:loadTools] 完整受管 OpenCode permission 白名单；配置只接受 canonical edit，它同时控制宿主 edit、write 和 apply_patch；execute 是可选实验性 Code Mode；null 不接管 allow/deny，[] 全部拒绝。
  "loadTools": ["question", "bash", "read", "glob", "grep", "edit", "task", "execute", "webfetch", "websearch", "lsp", "todowrite", "skill"],
  // [o4e:loadSkills] 完整 Skill 名称 allowlist；["*"] 不按名称限制，[] 全部拒绝，具体名称数组只开放对应 Skill。
  "loadSkills": ["*"],
  // [o4e:loadMcp] 完整 MCP 工具白名单；{"*": ["*"]} 开放全部 MCP，{} 明确关闭。
  "loadMcp": { "*": ["*"] },
  // [o4e:routing] 当前 Agent 可发现全部合法 all/subagent，并加载交付、修复、调查和研究入口。
  "loadAgents": ["*"],
  "loadWorkflows": ["feature-development", "bug-fix", "research-synthesis", "investigation", "implementation-change", "quality-gate"],
  "capabilities": ["workflow.coordinate", "implementation.change"]
}
